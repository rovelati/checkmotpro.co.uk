---
import Layout from '../../layouts/Layout.astro';
import RegLookup from '../../components/RegLookup.astro';
import makesModels from '../../data/uk_makes_models.json';

// Pre-render common sample plates or export static paths
export function getStaticPaths() {
  const platesSet = new Set<string>();
  makesModels.forEach(m => {
    m.models.forEach((mod: any) => {
      (mod.samplePlates || []).forEach((p: string) => platesSet.add(p.toLowerCase()));
    });
  });

  return Array.from(platesSet).map(vrm => ({
    params: { vrm },
    props: { vrm: vrm.toUpperCase() }
  }));
}

const { vrm } = Astro.params;
const formattedVrm = (vrm || '').toUpperCase();

const title = `MOT History & Road Tax Check: ${formattedVrm} — Free UK Report | CheckMOTPro`;
const description = `Instant MOT status, expiry date, mileage progression, failure reasons, advisories and DVLA road tax details for vehicle registration ${formattedVrm}.`;
---

<Layout title={title} description={description} canonical={`https://checkmotpro.co.uk/check/${vrm?.toLowerCase()}/`}>
  <div class="max-w-5xl mx-auto px-4 py-8">
    <div class="mb-4">
      <a href="/" class="text-xs text-zinc-400 hover:text-amber-400 font-semibold flex items-center gap-1.5">
        ← Back to Search
      </a>
    </div>

    <!-- Lookup Component with Auto Run enabled -->
    <RegLookup initialVrm={formattedVrm} autoLookup={true} />
  </div>
</Layout>
